#Pregunta 9 (Itza)


enif <- read_csv("/Users/luxi/Downloads/TMODULO.csv", col_types = cols(.default = "c"))

enif <- enif |>
  mutate(
    credito_formal = ifelse(
      P6_2_2 == "1" | P6_2_3 == "1" | P6_2_4 == "1" |
        P6_2_5 == "1" | P6_2_6 == "1" | P6_2_7 == "1",
      1, 0
    ),
    credito_formal = ifelse(is.na(credito_formal), 0, credito_formal)
  )

#X: informalidad laboral P3_13, servicios medicos por el trabajo
#1-6 = tiene prestaciones por su trabajo -> Formal(0)
#7 = carece de servicios medicos por su trabajo -> Informal (1)
#9 = no sabe, b/NA = no trabaja, fuera del analisis

enif <- enif |>
  mutate(
    informal = case_when(
      P3_13 %in% c("1","2","3","4","5","6") ~ 0,
      P3_13 == "7"                           ~ 1,
      TRUE                                   ~ NA_real_
    )
  )


#Preg 10a
library(tidyverse)

tabla_prop <- enif |>
  filter(!is.na(informal)) |>
  mutate(empleo  = if_else(informal == 1, "Informal", "Formal"),
         credito = if_else(credito_formal == 1, "Con credito", "Sin credito")) |>
  count(empleo, credito) |>
  group_by(empleo) |>
  mutate(prop = n / sum(n)) |>
  ungroup()

ggplot(tabla_prop, aes(x = credito, y = empleo, fill = prop)) +
  geom_tile(color = "white", linewidth = 1.2) +
  geom_text(aes(label = scales::percent(prop, accuracy = 0.1)),
            size = 6, color = "white", fontface = "bold") +
  scale_fill_gradient(low = "#deebf7", high = "#08519c",
                      labels = scales::percent_format(),
                      name = "Proporcion\n(por tipo de empleo)") +
  labs(title = "Acceso a credito formal segun tipo de empleo",
       subtitle = "Cada fila suma 100%",
       x = NULL, y = NULL) +
  theme_minimal(base_size = 13) +
  theme(panel.grid = element_blank())



