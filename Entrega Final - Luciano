#Punto 7: tres categorías de empleo
enif <- enif |>
  mutate(empleo3 = case_when(
    P3_13 %in% c("1","2","3","4","5","6") ~ "formal",
    P3_13 == "7"                          ~ "informal",
    TRUE                                  ~ "sin_empleo"))

# Tasa de crédito por categoría
enif |> group_by(empleo3) |> summarise(tasa_credito = mean(credito_formal))

# LPM con las tres categorías (formal = base)
enif$empleo3 <- relevel(factor(enif$empleo3), ref = "formal")
m_3cat <- lm(credito_formal ~ empleo3 + EDAD_V + NIV + SEXO + TLOC + REGION, data = enif)

summary(m_3cat)   # coef de informal y de sin_empleo, ambos vs formal

#Visualizzacion de datos formal, inf, desempleo
enif <- enif |>
  mutate(empleo3 = case_when(
    P3_13 %in% c("1","2","3","4","5","6") ~ "Formal",
