#Preg 13

#confusores

enif <- enif |>
  mutate(
    EDAD_V = as.numeric(EDAD_V),
    NIV = na_if(NIV, "99"),          
    NIV = factor(NIV),
    SEXO = factor(SEXO, levels = c("1","2"), labels = c("Hombre","Mujer")),
    TLO = factor(TLOC),            
    REGION = factor(REGION)            
  )

m_multi<- lm(credito_formal ~ informal + EDAD_V + NIV + SEXO + TLOC + REGION,
              data = enif)
summary(m_multi)


#-------Entrega 4-------------


# Regla practica: VIF > 5 (o 10) indica multicolinealidad preocupante.
vif(m_multi)

# H0: errores homocedasticos. Si p < 0.05, hay heterocedasticidad.
bptest(m_multi)

# coeficiente con errores robustos a heterocedasticidad (HC1):
coeftest(m_multi, vcov = vcovHC(m_multi, type = "HC1"))


