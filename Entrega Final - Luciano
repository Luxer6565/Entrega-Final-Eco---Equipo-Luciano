#P8 Probit y AME de informalidad 
probit <- glm(credito_formal ~ informal + EDAD_V + NIV + SEXO + TLOC + REGION,
              data = enif, family = binomial("probit"))

avg_slopes(probit, variables = "informal")   # AME ≈ -0.163

